# ---------------------------------------------------------------------------
# Copy to .env.local for development. On Vercel set these under
# Project → Settings → Environment Variables (see DEPLOY.md).
# ---------------------------------------------------------------------------

# --- Arc network ------------------------------------------------------------
# SERVER-ONLY. No NEXT_PUBLIC_ prefix on purpose: this provider authenticates with a
# key in the URL path (a wrong key returns 401), and NEXT_PUBLIC_ values are inlined
# into the client bundle where anyone could read them.
# The browser reaches Arc through /api/arc-rpc, which forwards read-only methods.
ARC_RPC_URL=

# Optional escape hatch: a KEYLESS Arc endpoint safe to expose to the browser. Setting
# this bypasses the proxy. Leave blank when the endpoint is credentialed.
NEXT_PUBLIC_ARC_RPC_URL=

# Optional absolute endpoint handed to the user's wallet by the "Add Arc" button.
# The app's own proxy is relative and read-only, so a wallet cannot use it. Leave unset
# rather than publishing a credentialed URL — the button then says to add Arc manually.
NEXT_PUBLIC_ARC_WALLET_RPC_URL=

# Arc mainnet explorer (Blockscout).
NEXT_PUBLIC_ARC_EXPLORER_URL=https://arc-mainnet.cloud.blockscout.com

# --- Base RPC ---------------------------------------------------------------
# STRONGLY RECOMMENDED in production. Left blank, viem falls back to the public
# Base endpoint, which rate-limits and will make balances flicker or fail under
# any real traffic. Use Alchemy/QuickNode/Infura.
NEXT_PUBLIC_BASE_RPC_URL=

# --- Circle Gateway --------------------------------------------------------
# Override the Gateway host (e.g. gateway-api-testnet.circle.com).
GATEWAY_API_URL=https://gateway-api.circle.com

# --- Relayer (server-only secret — never prefix with NEXT_PUBLIC_) ---------
# Submits gatewayMint on Arc for users who hold no Arc gas. Because Arc charges gas
# in USDC, a first-time bridger literally cannot complete the final step without
# either this or a pre-funded Arc balance.
#
# It only ever pays gas: gatewayMint credits destinationRecipient from the
# attestation, so the relayer cannot redirect funds.
#
# On Vercel mark this Sensitive and scope it to Production only.
# NEVER commit a real value.
ARC_RELAYER_PRIVATE_KEY=

# Refuse to relay when the relayer's Arc balance drops below this (wei, 18 dec).
# Default 0.02 USDC. Guards against a single caller draining the key.
ARC_RELAYER_MIN_BALANCE_WEI=20000000000000000
